NODE_ENV=development
PORT=4000
WEB_APP_URL=https://my-kasirku.vercel.app
CORS_ALLOWED_ORIGINS=https://my-kasirku.vercel.app,http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-at-least-32-characters
COOKIE_SECRET=replace-with-at-least-32-characters
CSRF_SECRET=replace-with-at-least-32-characters
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=my-cashier/products
CLOUDINARY_LOGO_FOLDER=my-cashier/logos
CLOUDINARY_PLACEHOLDER_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL="MY-CASHIER <invoice@example.com>"
RESEND_REPLY_TO_EMAIL=
APP_NAME=MY-CASHIER
LOG_LEVEL=info
MAX_UPLOAD_SIZE_MB=5
